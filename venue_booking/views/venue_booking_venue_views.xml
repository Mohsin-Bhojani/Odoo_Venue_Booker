<odoo>
    <record id="venue_booking_venue_action" model="ir.actions.act_window">
        <field name="name">Venues</field>
        <field name="res_model">venue.booking.venue</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="venue_booking_venue_view_list" model="ir.ui.view">
        <field name="name">venue.booking.venue.list</field>
        <field name="model">venue.booking.venue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
                <field name="city" />
                <field name="capacity" />
                <field name="hourly_rate" />
                <field name="booking_count" string="Bookings" />
            </list>
        </field>
    </record>

    <record id="venue_booking_venue_view_form" model="ir.ui.view">
        <field name="name">venue.booking.venue.form</field>
        <field name="model">venue.booking.venue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="city" />
                        <field name="capacity" />
                        <field name="hourly_rate" />
                        <field name="currency_id" options="{'no_create': True}" />
                        <field name="amenity_ids" widget="many2many_tags" />
                        <field name="description" />
                        <field name="active" />
                        <field name="booking_count" string="Total Bookings" />
                    </group>
                    <group>
                        <notebook>
                            <page string="Bookings">
                                <field name="booking_ids" />
                            </page>
                        </notebook>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>
</odoo>
