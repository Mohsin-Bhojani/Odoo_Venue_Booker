<odoo>
    <record id="venue_booking_amenity_action" model="ir.actions.act_window">
        <field name="name">Amenities</field>
        <field name="res_model">venue.booking.amenity</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="venue_booking_amenity_view_list" model="ir.ui.view">
        <field name="name">venue.booking.amenity.list</field>
        <field name="model">venue.booking.amenity</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="icon" />
            </list>
        </field>
    </record>

    <record id="venue_booking_amenity_view_form" model="ir.ui.view">
        <field name="name">venue.booking.amenity.form</field>
        <field name="model">venue.booking.amenity</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="icon" placeholder="e.g. fa-wifi" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
