<odoo>
    <record id="venue_booking_booking_action" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">venue.booking.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="venue_booking_booking_view_list" model="ir.ui.view">
        <field name="name">venue.booking.booking.list</field>
        <field name="model">venue.booking.booking</field>
        <field name="arch" type="xml">
            <list decoration-success="state == 'confirmed'"
                  decoration-muted="state == 'cancelled'"
                  decoration-warning="state == 'draft'">
                <field name="venue_id" />
                <field name="partner_id" />
                <field name="date_start" />
                <field name="date_end" />
                <field name="duration" string="Hrs" />
                <field name="total_amount" sum="Total" />
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-warning="state == 'draft'"
                       decoration-danger="state == 'cancelled'" />
            </list>
        </field>
    </record>

    <record id="venue_booking_booking_view_form" model="ir.ui.view">
        <field name="name">venue.booking.booking.form</field>
        <field name="model">venue.booking.booking</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm"
                            invisible="state != 'draft'" class="oe_highlight" />
                    <button name="action_create_invoice" type="object" string="Create Invoice"
                            invisible="state != 'confirmed' or invoice_id != False" class="oe_highlight" />
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state == 'cancelled'" />
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            invisible="state != 'cancelled'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,cancelled" />
                </header>
                <sheet>
                    <group col="2">
                        <group string="Booking Details" colspan="1">
                            <field name="name" readonly="1" />
                            <field name="venue_id" />
                            <field name="partner_id" />
                            <field name="date_start" />
                            <field name="date_end" />
                            <field name="duration" string="Duration (hrs)" />
                        </group>
                        <group string="Pricing" colspan="1">
                            <field name="hourly_rate" />
                            <field name="total_amount" widget="monetary" options="{'currency_field': 'currency_id'}" />
                            <field name="currency_id" invisible="1" />
                            <field name="invoice_id" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="venue_booking_booking_view_calendar" model="ir.ui.view">
        <field name="name">venue.booking.booking.calendar</field>
        <field name="model">venue.booking.booking</field>
        <field name="arch" type="xml">
            <calendar string="Bookings Calendar"
                      date_start="date_start"
                      date_stop="date_end"
                      color="venue_id"
                      mode="month">
<field name="venue_id" />
                <field name="partner_id" />
            </calendar>
        </field>
    </record>
</odoo>

